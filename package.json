{
  "name": "opd-scribe",
  "productName": "OPD Scribe",
  "version": "0.1.0",
  "description": "Offline oncology OPD documentation assistant",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "dist:win": "electron-vite build && electron-builder --win --x64",
    "dist:mac": "electron-vite build && electron-builder --mac"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "papaparse": "^5.7.0",
    "pdf-lib": "^1.17.1",
    "sql.js": "^1.15.1"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "fsevents@2.3.3": true
  },
  "author": "OPD Scribe"
}
